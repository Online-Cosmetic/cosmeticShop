# =========================
# Web static resources
# =========================
SPRING_WEB_RESOURCES_STATIC_LOCATIONS=classpath:/static/,classpath:/public/

# =========================
# Mail
# =========================
SPRING_MAIL_HOST=localhost

# =========================
# JPA / Hibernate
# =========================
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
